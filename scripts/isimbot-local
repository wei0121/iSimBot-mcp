#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/local-env.sh"
require_local_runtime
if [[ ! -f "$ISIMBOT_PROJECT_ROOT/dist/index.js" ]]; then
  echo 'Build missing. Run ./scripts/local-npm run build.' >&2
  exit 1
fi
exec "$ISIMBOT_RUNTIME/node/bin/node" "$ISIMBOT_PROJECT_ROOT/dist/index.js" "$@"
